# Demo runs entirely on simulated data. These are the production seams.
THE_LINK_MODE=demo                     # demo | live
NEXT_PUBLIC_SITE_URL=https://shipping-os-kappa.vercel.app
DATABASE_URL=                          # PostgreSQL (future store adapter)
WHATSAPP_VERIFY_TOKEN=demo-verify-token
WHATSAPP_ACCESS_TOKEN=                 # Cloud API — never used in demo mode
WHATSAPP_PHONE_NUMBER_ID=
# Request context for API routes:
#   demo    = X-Organization / ?org= picks the org and acts as its demo customer (DEMO TRANSPORT, not an auth boundary)
#   session = identity from setAuthenticator() (src/server/requestContext.ts); org header only selects among memberships
SHIPPING_OS_AUTH_MODE=demo
