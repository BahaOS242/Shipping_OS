# Restricted application login inheriting shipping_os_app. No browser credentials.
# For remote PostgreSQL, use certificate-verified TLS (sslmode=verify-full).
DATABASE_URL=postgresql://shipping_os_runtime:REPLACE@localhost:5432/shipping_os_pilot
PILOT_ORIGIN=http://localhost:3000
# ADMIN_DATABASE_URL is supplied ONLY to migration/provision commands, never Next.js.

# Existing simulated demo settings
THE_LINK_MODE=demo
NEXT_PUBLIC_SITE_URL=https://shipping-os-kappa.vercel.app
WHATSAPP_VERIFY_TOKEN=demo-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Notification worker only: keep these outside the Next.js runtime environment.
EMAIL_DELIVERY_ENABLED=false
WORKER_DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
